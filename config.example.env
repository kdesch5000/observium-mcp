# Observium MCP Server Configuration (local / stdio / development)
# Copy to .env and fill in. For the systemd service, deploy/install.sh writes
# /etc/observium-mcp/observium-mcp.env instead.

# Transport: stdio (default) or http
# OBSERVIUM_MCP_TRANSPORT=stdio
# OBSERVIUM_MCP_HOST=127.0.0.1
# OBSERVIUM_MCP_PORT=18765
# OBSERVIUM_MCP_TOKEN=          # required for http: openssl rand -hex 32
# OBSERVIUM_MCP_ALLOWED_HOSTS=  # e.g. observium-host.your-tailnet.ts.net:8765,127.0.0.1:*

# Database — prefer the unix socket when running on the Observium host
OBSERVIUM_DB_SOCKET=/run/mysqld/mysqld.sock
# OBSERVIUM_DB_HOST=localhost
# OBSERVIUM_DB_PORT=3306
OBSERVIUM_DB_NAME=observium
OBSERVIUM_DB_USER=observium_mcp
OBSERVIUM_DB_PASS=your_database_password

# RRD data path (local disk on the Observium host)
OBSERVIUM_RRD_PATH=/opt/observium/rrd
